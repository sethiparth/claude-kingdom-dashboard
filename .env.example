# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# In production, restrict to your domain
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# File Paths
# Override default paths if needed
# AGENT_STATUS_FILE=/custom/path/to/agent-status.json
# KING_BOB_IMAGE=/custom/path/to/king-bob.png

# Polling Configuration (client-side, for reference)
POLL_INTERVAL=1000

# Debug Mode
DEBUG=false
